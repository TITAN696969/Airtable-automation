# Copy to .env and fill in real values. Never commit .env.

### index.js — generation worker ############################################

# Required
AIRTABLE_API_KEY=
GEMINI_API_KEY=

# Optional (defaults shown)
AIRTABLE_BASE_ID=app7381NQaLvJhj2Y
AIRTABLE_TABLE_ID=tblZLPqHrhyAIGHW9
AIRTABLE_MODELS_TABLE=Models
GEMINI_MODEL=gemini-3.1-flash-image
POLL_MS=15000
STALE_MS=1200000
PORT=3000

# Drive uploads (optional — pick ONE auth mode, or leave all blank to disable)
DRIVE_ROOT_FOLDER_ID=
# Mode A: service account (base64-encoded key JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Mode B: OAuth as yourself (run scripts/drive-oauth-setup.js once to get the refresh token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

DRIVE_LINK_FIELD=Drive Folder
REROLL_OF_FIELD=Reroll Of
SYNC_SWEEP_MS=300000

### promote.js — promotion bridge ############################################
# Reuses AIRTABLE_*, GOOGLE_*/DRIVE_* above, plus:

APPROVED_FIELD=Creative Approved
PROMOTED_FIELD=Promoted
PROMOTE_POLL_MS=120000
PROMOTE_PORT=3002

### distribute.js — allocation worker #########################################

# Required
IG_MASTER_API_KEY=
IG_MASTER_BASE_ID=

# Optional (defaults shown)
IG_ACCOUNTS_TABLE=IG Accounts
IG_MASTER_MODELS_TABLE=Models
READY_TO_POST_TABLE=Ready to Post
CAROUSEL_DIST_TABLE=Carousel Distribution
DISTRIBUTE_POLL_MS=60000
DISTRIBUTE_PORT=3001

WARMUP_POSTS_FROM_DAY=3
WARMUP_DAILY_POSTS=1
ACTIVE_DAILY_POSTS=3
ALLOCATE_HORIZON_DAYS=14
