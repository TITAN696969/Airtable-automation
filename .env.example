# Copy to .env and fill in real values. Never commit .env.

### index.js — generation worker ############################################

# Required
AIRTABLE_API_KEY=
GEMINI_API_KEY=

# Optional (defaults shown)
AIRTABLE_BASE_ID=app7381NQaLvJhj2Y
AIRTABLE_TABLE_ID=tblZLPqHrhyAIGHW9
AIRTABLE_MODELS_TABLE=Models
GEMINI_MODEL=gemini-3.1-flash-image
POLL_MS=15000
STALE_MS=1200000
PORT=3000

# Drive uploads (optional — pick ONE auth mode, or leave all blank to disable)
DRIVE_ROOT_FOLDER_ID=
# Mode A: service account (base64-encoded key JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Mode B: OAuth as yourself (run scripts/drive-oauth-setup.js once to get the refresh token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

DRIVE_LINK_FIELD=Drive Folder
REROLL_OF_FIELD=Reroll Of
SYNC_SWEEP_MS=300000

### promote.js — promotion bridge ############################################
# Reuses AIRTABLE_*, GOOGLE_*/DRIVE_* above, plus:

APPROVED_FIELD=Creative Approved
PROMOTED_FIELD=Promoted
PROMOTE_POLL_MS=120000
PROMOTE_PORT=3002

### distribute.js — allocation worker #########################################

# Required
IG_MASTER_API_KEY=
IG_MASTER_BASE_ID=

# Optional (defaults shown)
IG_ACCOUNTS_TABLE=IG Accounts
IG_MASTER_MODELS_TABLE=Models
READY_TO_POST_TABLE=Ready to Post
CAROUSEL_DIST_TABLE=Carousel Distribution
DISTRIBUTE_POLL_MS=60000
DISTRIBUTE_PORT=3001

WARMUP_POSTS_FROM_DAY=3
WARMUP_DAILY_POSTS=1
ACTIVE_DAILY_POSTS=3
ALLOCATE_HORIZON_DAYS=14

### cleanup.js — deletes fully-posted source rows (e.g. Clip Farm) ###########
# Cross-base: checks IG_MASTER_*/READY_TO_POST_TABLE above for every row
# linking back to a source row, and only deletes the source row once ALL of
# its linked Ready to Post rows are done. Deploy one instance per pipeline
# (Clip Farm, Kling, Transition, Videos, ...) - each has its own link field.

# The field on a Ready to Post row holding the source row's record id.
# e.g. "Clip Farm Row ID", "Kling Row ID", "Transition Row ID", "Videos Row ID"
CLEANUP_LINK_FIELD=Clip Farm Row ID
CLEANUP_STATUS_FIELD=Status
# Comma-separated Ready to Post Status values that count as "done with this
# content" - a linked row still in Ready/Scheduled blocks deletion.
CLEANUP_DONE_STATUSES=Posted,Churned

# Required - the base/table actually being cleaned (its own Airtable
# account/key, separate from IG_MASTER_* / AIRTABLE_* above).
CLEANUP_SOURCE_API_KEY=
CLEANUP_SOURCE_BASE_ID=
CLEANUP_SOURCE_TABLE=

# Optional (defaults shown)
CLEANUP_PREVIEW_FIELD=
CLEANUP_POLL_MS=1800000
CLEANUP_PORT=3003
CLEANUP_MAX_DELETES_PER_RUN=100
# Defaults to true (logs only, deletes nothing). Set to the literal string
# "false" once you've confirmed a dry run matched the right rows.
CLEANUP_DRY_RUN=true
